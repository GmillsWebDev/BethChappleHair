# Apache config for Eco Web Hosting (cPanel).
# Every block is wrapped in <IfModule> so a missing module can't take the site down.

ErrorDocument 404 /404.html

# One canonical address: https://bethchapplehair.co.uk/ (no www, no index.html)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://bethchapplehair.co.uk%{REQUEST_URI} [L,R=301]

  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [L,R=301]

  # Gallery images renamed 2026-11-17 (old names may be indexed in Google Images)
  RewriteRule ^img/gallery/Gallery8\.webp$ /img/gallery/bridal-updo-braid-flowers.webp [L,R=301]
  RewriteRule ^img/gallery/Gallery9\.webp$ /img/gallery/blonde-balayage-long-waves.webp [L,R=301]
  RewriteRule ^img/gallery/Gallery2\.webp$ /img/gallery/caramel-honey-balayage.webp [L,R=301]
  RewriteRule ^img/gallery/Gallery3\.webp$ /img/gallery/golden-blonde-glossy-waves.webp [L,R=301]
  RewriteRule ^img/gallery/Gallery4\.webp$ /img/gallery/brunette-low-chignon.webp [L,R=301]
  RewriteRule ^img/gallery/Gallery5\.webp$ /img/gallery/hidden-rainbow-colour.webp [L,R=301]
  RewriteRule ^img/gallery/Gallery6\.webp$ /img/gallery/rose-gold-inverted-bob.webp [L,R=301]
  RewriteRule ^img/gallery/Gallery7\.webp$ /img/gallery/copper-hair-long-waves.webp [L,R=301]
  RewriteRule ^img/gallery/Bridal\.webp$ /img/gallery/bridal-chignon-purple-flowers.webp [L,R=301]
  RewriteRule ^img/gallery/Gallery15\.webp$ /img/gallery/blonde-pixie-long-fringe.webp [L,R=301]
  RewriteRule ^img/gallery/Gallery10\.webp$ /img/gallery/copper-auburn-waves.webp [L,R=301]
  RewriteRule ^img/gallery/Gallery14\.webp$ /img/gallery/pastel-pink-textured-crop.webp [L,R=301]
  RewriteRule ^img/gallery/Gallery11\.webp$ /img/gallery/lived-in-blonde-balayage.webp [L,R=301]
  RewriteRule ^img/gallery/Gallery12\.webp$ /img/gallery/bronde-balayage.webp [L,R=301]
  RewriteRule ^img/gallery/Gallery13\.webp$ /img/gallery/icy-blonde-highlights.webp [L,R=301]
</IfModule>

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# Browser caching. CSS/JS links carry ?v=N - bump N when you change those files.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType image/vnd.microsoft.icon "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
